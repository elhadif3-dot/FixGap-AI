# Never commit real credentials. Set these values in .env.local or Vercel server-side settings.
LLM_MODE=live
LLM_PROVIDER=gemini
LLM_LIVE_MODULES=agent,supervisor
ENABLE_AGENT_DECISION_LLM=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=4096

# Existing read-only review index; runtime queries by stored review ID.
PINECONE_API_KEY=
PINECONE_REVIEW_INDEX=airbnb-reviews
PINECONE_REVIEW_NAMESPACE=airbnb-reviews-rich-50
REQUIRE_PINECONE_RAG=true

# Cached listing/nearby data and simulated Owner-page state.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
REQUIRE_SUPABASE_RUNTIME=true

# Local-only development blocks Supabase page/audit writes. Do not enable in production.
FIXGAP_LOCAL_ONLY=true

# Optional independent signing key for stateless production Guest updates.
# When empty, the server derives the signature from SUPABASE_SERVICE_ROLE_KEY.
GUEST_SESSION_SECRET=

# Optional local Gemini timeout (15-180 seconds). Production uses 60 seconds per call.
GEMINI_LOCAL_TIMEOUT_SECONDS=120

# Legacy LLMod.ai fallback only. Not required for the Gemini + Pinecone-by-ID workflow.
# LLMOD_API_KEY=
# LLMOD_BASE_URL=
# LLMOD_TEXT_MODEL=MB5R2CF-azure/gpt-5.4-mini
# LLMOD_EMBEDDING_MODEL=MB5R2CF-azure/text-embedding-3-small
